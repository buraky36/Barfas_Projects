	(text "VDDA HF rejection capacitor"
		(exclude_from_sim no)
		(at 245.364 88.646 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0d1e1f13-a745-4494-85fa-eed39bc0a4b1")
	)
	(text "1. KNX gerekliliklerini karşılamak için C13 ve C14'nin toplam yükü 121 mC'yi aşmamalıdır.\n2. C14 yüksek kondansatör değeri, çalıştırma süresini etkileyebilir.\n3. C14 Bu pini VFILT piniyle kısa devre yapmak mümkündür\n4. R40 Herhangi bir direnç bağlanmamışsa veya 3,3 V'a çekilmemişse, KNX cihazı 10 mA'lık bir veri\n    yolu yükü olarak sertifikalandırılmalıdır. Toprağa kısa devre yapıldığında, KNX cihazı\n    20 mA'lık bir veri yolu yükü olarak sertifikalandırılmalıdır. Toprağa 10 k ile 93,1 k arasında\n    bir direnç bağlanırsa, cihaz 10 mA (42,2 k), 20 mA (20 k), 30 mA (13,3 k) veya 40 mA (10 k) bus yükü olarak sertifikalandırılmalıdır."
		(exclude_from_sim no)
		(at 13.208 161.798 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "2b8df873-2dd2-4ffe-99a1-d0b2d203538c")
	)
	(text "Comp. 	Function							 Min	 Typ	 Max 	Unit\n\nC13 	Storage and filter capacitor VFILT 	12.5 	100 	4000 	uF\nC14 	Load Capacitor V20V					 − 		 1 		− 		uF\nR35	    DC1 sensing resistor 				0.47	 1 		10  	R"
		(exclude_from_sim no)
		(at 13.716 185.42 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "2ec505e6-a92c-486e-ac22-46e71d24e193")
	)
